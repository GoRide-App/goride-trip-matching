{
  "info": {
    "name": "GoRide Trip Matching — Fare & Drivers",
    "description": "Regression pack for goride-trip-matching. Covers all three HTTP endpoints found in the controllers: /health, POST /fare/estimate (SCRUM-54), and GET /drivers/active. No auth header required on any of them — none of these controllers carry an [Authorize] attribute. baseUrl defaults to http://localhost:8080 (the Docker Compose port you already confirmed working) — change it to match your dotnet run launch profile if running outside Docker.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "GET /health — service and DB are up",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('status is healthy', () => pm.expect(body.status).to.eql('healthy'));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Fare Estimate (SCRUM-54)",
      "item": [
        {
          "name": "Estimate fare — happy path (Colombo Fort to Bambalapitiya)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/fare/estimate", "host": ["{{baseUrl}}"], "path": ["fare","estimate"] },
            "body": { "mode": "raw", "raw": "{\n  \"startLat\": 6.9344,\n  \"startLng\": 79.8428,\n  \"endLat\": 6.8905,\n  \"endLng\": 79.8565\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('response is a non-empty array of fare options', () => {",
              "  pm.expect(body).to.be.an('array');",
              "  pm.expect(body.length).to.be.greaterThan(0);",
              "});",
              "pm.test('exactly one vehicle type is available (TukTuk-only rule)', () => {",
              "  const availableCount = body.filter(o => o.available === true).length;",
              "  pm.expect(availableCount).to.eql(1);",
              "});",
              "pm.test('every option carries the same distance and duration', () => {",
              "  const distances = new Set(body.map(o => o.distanceKm));",
              "  pm.expect(distances.size).to.eql(1);",
              "});"
            ]}
          }]
        },
        {
          "name": "Estimate fare — missing startLat is refused (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/fare/estimate", "host": ["{{baseUrl}}"], "path": ["fare","estimate"] },
            "body": { "mode": "raw", "raw": "{\n  \"startLng\": 79.8428,\n  \"endLat\": 6.8905,\n  \"endLng\": 79.8565\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 400', () => pm.response.to.have.status(400));"
            ]}
          }]
        },
        {
          "name": "Estimate fare — missing endLng is refused (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/fare/estimate", "host": ["{{baseUrl}}"], "path": ["fare","estimate"] },
            "body": { "mode": "raw", "raw": "{\n  \"startLat\": 6.9344,\n  \"startLng\": 79.8428,\n  \"endLat\": 6.8905\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 400', () => pm.response.to.have.status(400));"
            ]}
          }]
        },
        {
          "name": "Estimate fare — identical start and end coordinates (zero distance)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/fare/estimate", "host": ["{{baseUrl}}"], "path": ["fare","estimate"] },
            "body": { "mode": "raw", "raw": "{\n  \"startLat\": 6.9344,\n  \"startLng\": 79.8428,\n  \"endLat\": 6.9344,\n  \"endLng\": 79.8428\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200 (no validation blocks a zero-distance request)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('distanceKm is exactly 0', () => pm.expect(body[0].distanceKm).to.eql(0));"
            ]}
          }]
        },
        {
          "name": "Estimate fare — out-of-range latitude is NOT rejected (gap, not a bug fix expectation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/fare/estimate", "host": ["{{baseUrl}}"], "path": ["fare","estimate"] },
            "body": { "mode": "raw", "raw": "{\n  \"startLat\": 200,\n  \"startLng\": 79.8428,\n  \"endLat\": 6.8905,\n  \"endLng\": 79.8565\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status code is 200 — FareCalculationService has no lat/lng range validation, so this documents current behaviour rather than asserting it is correct', () => pm.response.to.have.status(200));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Active Drivers",
      "item": [
        {
          "name": "Get active drivers — no vehicleType filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/drivers/active", "host": ["{{baseUrl}}"], "path": ["drivers","active"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "// This proxies to identity-auth's internal endpoint and needs InternalServices:ApiKey",
              "// configured on both services plus identity-auth actually running — I haven't verified",
              "// that's wired up locally, so this only asserts the route itself exists rather than a 200.",
              "pm.test('Route exists (not a 404)', () => pm.expect(pm.response.code).to.not.equal(404));"
            ]}
          }]
        },
        {
          "name": "Get active drivers — filtered by vehicleType=TUK",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/drivers/active?vehicleType=TUK", "host": ["{{baseUrl}}"], "path": ["drivers","active"], "query": [{ "key": "vehicleType", "value": "TUK" }] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Route exists (not a 404)', () => pm.expect(pm.response.code).to.not.equal(404));"
            ]}
          }]
        }
      ]
    }
  ]
}
